{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ten100compkdeploy-production.up.railway.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://ten100compkdeploy-production.up.railway.app/uploads/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://ten100compkdeploy-production.up.railway.app/socket.io/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
